export const base_url="https://dummyjson.com/recipes";


export async function callApi(limit){
   let res=await fetch(base_url+"?limit="+limit) 
   let data=await res.json()
   return data

}
export async function getSearchRecipe(recipe){
   let apiRecipe=encodeURIComponent(recipe)
    let res=await fetch(`${base_url}/search?q=${apiRecipe}`) 
   let data=await res.json()
   return data
}